{
  // Rule config lives in .markdownlint.json (auto-merged by markdownlint-cli2).
  // This file only adds cli2-specific options.
  //
  // CHANGELOG.md is machine-generated by release-please in a fixed format
  // (`*` bullets, extra blank lines) that conflicts with our rules and would
  // break Lint on every release. Honored regardless of how cli2 is invoked
  // (CLI, editor, pre-commit) — unlike .markdownlintignore, which cli2 does
  // not apply to explicitly-globbed files. Kept in sync with .prettierignore.
  "ignores": ["CHANGELOG.md"]
}
